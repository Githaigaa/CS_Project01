# Copy this to .env for local development.
# On Vercel, set these in the dashboard under Project > Settings > Environment Variables.

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-project.vercel.app

# Database — use DATABASE_URL (from Vercel Postgres / Neon) OR individual vars
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# OR individual variables (if not using DATABASE_URL):
# POSTGRES_DB=cattletrace
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_HOST=your-db-host
# POSTGRES_PORT=5432

# Email (optional — uses console backend if not set)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=mundia.software@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=CattleTrace <noreply@cattletrace.ke>

# CORS — add your Vercel frontend URL if deploying as separate projects
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
